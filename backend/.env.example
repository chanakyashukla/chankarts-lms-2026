# ---- Database (persistent) -------------------------------------------------
# Application traffic uses the POOLED Neon endpoint with the installed asyncpg
# driver (verified against live Neon):
#   postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?ssl=require
# NOTE: for asyncpg use ?ssl=require — libpq-only parameters (sslmode=...,
# channel_binding=...) are rejected by this driver.
DATABASE_URL=postgresql+asyncpg://user:password@HOST-pooler.REGION.aws.neon.tech/neondb?ssl=require
# Optional: DIRECT (non-pooler) endpoint used ONLY by Alembic migrations
# (Neon guidance: migrations should not run through the pooled endpoint).
# The application always uses DATABASE_URL above. Leave empty to fall back.
# MIGRATIONS_DATABASE_URL=postgresql+asyncpg://user:PASSWORD@HOST.REGION.aws.neon.tech/neondb?ssl=require
# SQLite (local development):
# DATABASE_URL=sqlite+aiosqlite:///./local.db

# ---- Authentication --------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Application -----------------------------------------------------------
APP_NAME=ChankArts Music Academy LMS
APP_VERSION=1.0.0
DEBUG=false
FRONTEND_URL=https://academy.chankarts.com
# Optional extra CORS origins (comma separated) — defaults already include
# chankarts.com, academy.chankarts.com and localhost development ports.
ALLOWED_ORIGINS=
TIMEZONE=Asia/Kolkata
CURRENCY=INR

# ---- Seed administrator (created once at first startup) --------------------
SEED_ADMIN_EMAIL=admin@chankarts.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_FIRST_NAME=ChankArts
SEED_ADMIN_LAST_NAME=Admin

# ---- Email (Web3Forms) -----------------------------------------------------
WEB3FORMS_ACCESS_KEY=
EMAIL_TEST_MODE=true
ADMIN_EMAIL=chankarts.official@gmail.com
FROM_NAME=ChankArts Music Academy

# ---- Razorpay (optional — leave mode=disabled to run without it) -----------
RAZORPAY_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ---- Uploads ---------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
REGISTRATION_RATE_LIMIT_ATTEMPTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
