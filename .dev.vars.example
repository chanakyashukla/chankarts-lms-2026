# Cloudflare Workers — local development secrets template.
# Copy to .dev.vars (never committed) or set as production secrets with:
#   npx wrangler secret put <NAME>
#
# DATABASE_URL: Neon PostgreSQL connection string (use the pooled /pgbouncer
# form for serverless, e.g. ...?sslmode=require&pgbouncer=true).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb

# Strong random string used to sign access tokens (REQUIRED in production).
SECRET_KEY=replace-with-a-long-random-string

# Initial administrator — created once at first boot. Change immediately
# after first sign-in. Never reuse the GitHub Pages demo credentials.
SEED_ADMIN_EMAIL=admin@chankarts.com
SEED_ADMIN_USERNAME=chanakya.shukla
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_FIRST_NAME=Chanakya
SEED_ADMIN_LAST_NAME=Sir

# Durable uploads (R2 bucket + R2 API token with Object Read & Write,
# scoped to the single bucket).
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Optional integrations (leave empty to keep them disabled):
# RAZORPAY_MODE=disabled
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# WEB3FORMS_ACCESS_KEY=
